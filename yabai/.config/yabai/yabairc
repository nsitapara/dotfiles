#!/bin/bash
set -euo pipefail
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"

# No scripting addition or SIP changes. Based on the docked AeroSpace profile.
yabai -m config layout bsp
yabai -m config split_ratio 0.50
yabai -m config auto_balance off
yabai -m config window_placement second_child
yabai -m config window_origin_display focused
yabai -m config focus_follows_mouse off
yabai -m config mouse_follows_focus off
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config window_gap 15
yabai -m config top_padding 50
yabai -m config bottom_padding 8
yabai -m config left_padding 10
yabai -m config right_padding 10

# Apply the selection border even when AeroSpace has not run this session.
if command -v borders >/dev/null 2>&1; then
    (
        if [ -r "$HOME/.config/omarchy/current/borders.sh" ]; then
            source "$HOME/.config/omarchy/current/borders.sh"
        fi
        borders active_color="${BORDER_ACTIVE:-0xffcba6f7}" \
            inactive_color="${BORDER_INACTIVE:-0xff585b70}" \
            width="${BORDER_WIDTH:-8.0}"
    ) >/dev/null 2>&1 &
fi

# Labelled rules replace themselves on reload. App names are yabai's API.
yabai -m rule --add label=dotfiles-utilities \
    app='^(System Settings|System Preferences|Activity Monitor|App Store|Clock|FaceTime|1Password|Nuvio)$' manage=off
yabai -m rule --add label=dotfiles-stack-manager \
    app='^Electron$' title='^Worktree & Stack Manager$' manage=off

# Retire the old fixed-workspace rules in an already-running session, too.
yabai -m rule --remove dotfiles-dev 2>/dev/null || true
yabai -m rule --remove dotfiles-collaboration 2>/dev/null || true

# New windows from the formerly pinned apps should receive keyboard focus.
yabai -m signal --add label=dotfiles-focus-new-app-window event=window_created \
    app='^(Warp|PyCharm|GitHub Desktop|Slack)$' \
    action='PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"; yabai -m window --focus "$YABAI_WINDOW_ID"'

# Cmd+Tab can switch to a hidden or minimized app without revealing it.
yabai -m signal --add label=dotfiles-unhide-front-app event=application_front_switched \
    action='"$HOME/.config/yabai/scripts/reveal-app.sh" "$YABAI_PROCESS_ID"'

# Native 'recent' excludes floating windows, so retain a pair from focus events.
/usr/bin/python3 "$HOME/.config/yabai/scripts/focus-previous.py" reset
yabai -m signal --add label=dotfiles-focus-history event=window_focused \
    action='/usr/bin/python3 "$HOME/.config/yabai/scripts/focus-previous.py" record'

# Update app icons for same-app window changes, too.
for event in window_created window_destroyed window_focused window_title_changed; do
    yabai -m signal --add label="dotfiles-$event" event="$event" \
        action='PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"; command -v sketchybar >/dev/null && sketchybar --trigger yabai_windows_changed'
done

# Native Space/display activation can leave Finder active with no focused window.
# Keyboard/bar switches also run this guard, including clicks on the current Space.
for event in space_changed display_changed; do
    yabai -m signal --add label="dotfiles-focus-$event" event="$event" \
        action='/usr/bin/python3 "$HOME/.config/yabai/scripts/focus-space.py" --restore'
done

# Hotplug works even if SketchyBar is stopped. The helper debounces geometry
# changes and never switches the window manager or repairs physical displays.
for event in display_added display_removed display_moved display_resized; do
    yabai -m signal --add label="dotfiles-$event" event="$event" \
        action='"$HOME/.config/yabai/scripts/display-profile.sh"'
done

# wm.sh creates and labels desktops once the daemon is ready.
if [ -n "${DOTFILES_YABAI_READY:-}" ]; then
    touch "$DOTFILES_YABAI_READY"
fi
