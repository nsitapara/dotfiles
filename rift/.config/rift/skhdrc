# Rift shortcuts. Same keys as yabai; see RIFT.md for action differences.
# skhd executes actions through /bin/bash, set by wm.sh.
# Modes exit with Escape or Space. Cmd+F expands the focused window within its workspace.
# Reserved for Raycast: Cmd+Shift+C/E/G/B/P/S/V/Z/D, Cmd+Return,
# Alt+Shift+M, Ctrl+Cmd+Space. Keep modes non-capturing so these pass through.
:: default : "$HOME/.config/skhd/mode.sh" default
:: resize : "$HOME/.config/skhd/mode.sh" resize
:: workspace : "$HOME/.config/skhd/mode.sh" workspace
:: insertion : "$HOME/.config/skhd/mode.sh" insertion
:: service : "$HOME/.config/skhd/mode.sh" service

cmd - h : true
cmd + alt - h : true
cmd - left : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action focus left
cmd + shift - left : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action move left
cmd - down : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action focus down
cmd + shift - down : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action move down
cmd - up : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action focus up
cmd + shift - up : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action move up
cmd - right : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action focus right
cmd + shift - right : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action move right

# skhd names special keys differently from AeroSpace. Use macOS keycodes for
# punctuation: 0x18 = equals, 0x1B = minus, 0x2B = comma.
cmd - 0x18 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action resize width 32
cmd - 0x1B : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action resize width -32
cmd + ctrl - 0x18 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action preset up
cmd + ctrl - 0x1B : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action preset down
cmd + shift - 0x18 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action resize height 32
cmd + shift - 0x1B : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action resize height -32
# Reset window sizes in the current space.
cmd - 0 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action balance
cmd + ctrl - 0 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action balance
cmd - j : rift-cli execute layout toggle-orientation
cmd - 0x2B : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action layout
cmd - f : rift-cli execute window toggle-fullscreen-within-gaps

