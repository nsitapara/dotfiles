@@ -53,6 +53,18 @@ static void event_system_woke(void* context) {
   bar_manager_handle_system_woke(&g_bar_manager);
 }
 
+// Unlocking does not invalidate the rendering surfaces. The real wake path
+// rebuilds them for power/display recovery; using it here blanks every item.
+static void event_system_unlocked(void* context) {
+  bar_manager_handle_space_change(&g_bar_manager, true);
+  bar_manager_handle_display_change(&g_bar_manager);
+  g_bar_manager.needs_ordering = true;
+  bar_manager_refresh(&g_bar_manager, true);
+  bar_manager_custom_events_trigger(&g_bar_manager,
+                                    COMMAND_SUBSCRIBE_SYSTEM_WOKE,
+                                    NULL);
+}
+
 static void event_system_will_sleep(void* context) {
   bar_manager_handle_system_will_sleep(&g_bar_manager);
 }
