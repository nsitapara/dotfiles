Replace a known window when its app reopens it with a new accessibility element.

diff --git a/src/event_loop.c b/src/event_loop.c
index ed9018a..e829963 100644
--- a/src/event_loop.c
+++ b/src/event_loop.c
@@ -548,13 +548,29 @@ static EVENT_HANDLER(APPLICATION_HIDDEN)
     event_signal_push(SIGNAL_APPLICATION_HIDDEN, application);
 }
 
+static EVENT_HANDLER(WINDOW_DESTROYED);
+
 static EVENT_HANDLER(WINDOW_CREATED)
 {
     uint32_t window_id = ax_window_id(context);
     if (!window_id) { CFRelease(context); return; }
 
+    //
+    // NOTE: Apps that order a window out on close (Spotify, ChatGPT) reopen it with a new element
+    // under the same id. The old element stops responding and its destroyed notification never
+    // arrives, so replace the window instead of ignoring the new element.
+    //
+
     struct window *existing_window = window_manager_find_window(&g_window_manager, window_id);
-    if (existing_window) { CFRelease(context); return; }
+    if (existing_window) {
+        if (CFEqual(existing_window->ref, context) ||
+            !__sync_bool_compare_and_swap(&existing_window->id_ptr, &existing_window->id, &existing_window->id)) {
+            CFRelease(context);
+            return;
+        }
+
+        EVENT_HANDLER_WINDOW_DESTROYED(existing_window, 0);
+    }
 
     pid_t window_pid = ax_window_pid(context);
     if (!window_pid) { CFRelease(context); return; }
