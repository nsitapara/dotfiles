# Laptop workspaces when both external monitors are connected.
cmd - 7 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action workspace 7
cmd + shift - 7 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 7 --follow
cmd + ctrl + shift - 7 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 7
cmd - 0x59 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action workspace 7
cmd + shift - 0x59 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 7 --follow
cmd + ctrl + shift - 0x59 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 7
cmd - 8 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action workspace 8
cmd + shift - 8 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 8 --follow
cmd + ctrl + shift - 8 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 8
cmd - 0x5B : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action workspace 8
cmd + shift - 0x5B : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 8 --follow
cmd + ctrl + shift - 0x5B : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 8
cmd - 9 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action workspace 9
cmd + shift - 9 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 9 --follow
cmd + ctrl + shift - 9 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 9
cmd - 0x5C : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action workspace 9
cmd + shift - 0x5C : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 9 --follow
cmd + ctrl + shift - 0x5C : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 9

cmd - pageup : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action workspace prev
cmd - pagedown : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action workspace next
cmd - home : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action workspace 1
cmd - end : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action workspace 6
alt - tab : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action workspace recent
ctrl - tab : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action previous-window
cmd + ctrl - right : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action display next
cmd + ctrl - left : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action display prev
cmd + ctrl + shift - f : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action float
cmd + ctrl + alt + shift - f : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action float
cmd + ctrl + alt + shift - d : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action balance
cmd + ctrl + alt + shift - r ; resize
cmd + ctrl + alt + shift - w ; workspace
cmd + ctrl + alt + shift - m ; insertion
cmd + alt - s ; service
f14 ; service
alt + shift - c : /usr/bin/python3 "$HOME/.config/rift/adapter.py" reload

resize, workspace, insertion, service < escape ; default
resize, workspace, insertion, service < space ; default
service < f15 ; default

resize < left : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action resize width -16
resize < shift - left : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action resize width -64
resize < down : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action resize height 16
resize < shift - down : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action resize height 64
resize < up : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action resize height -16
resize < shift - up : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action resize height -64
resize < right : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action resize width 16
resize < shift - right : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action resize width 64

workspace < left : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action workspace prev
workspace < right : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action workspace next
workspace < up : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action display prev --focus
workspace < down : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action display next --focus
workspace < shift - left : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send prev --follow
workspace < shift - right : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send next --follow
workspace < shift - up : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action display prev
workspace < shift - down : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action display next

insertion < left : rift-cli execute layout join-window left
insertion < down : rift-cli execute layout join-window down
insertion < up : rift-cli execute layout join-window up
insertion < right : rift-cli execute layout join-window right

# ? is Shift + slash (macOS keycode 0x2C).
service < shift - 0x2C : sketchybar --trigger wm_help_toggle
service < f : skhd -k "f15"; /usr/bin/python3 "$HOME/.config/rift/adapter.py" action float
service < r : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action balance
service < up : osascript -e 'set volume output volume ((output volume of (get volume settings)) + 5)'
service < down : osascript -e 'set volume output volume ((output volume of (get volume settings)) - 5)'
service < shift - down : osascript -e 'set volume output volume 0'

# Rift layout choices in service mode (F14 or Cmd+Alt+S).
service < b : rift-cli execute workspace set-layout bsp; skhd -k "f15"
service < t : rift-cli execute workspace set-layout traditional; skhd -k "f15"
service < s : rift-cli execute workspace set-layout stack; skhd -k "f15"
service < m : rift-cli execute workspace set-layout master_stack; skhd -k "f15"
service < c : rift-cli execute workspace set-layout scrolling; skhd -k "f15"
service < g : rift-cli execute layout toggle-stack; skhd -k "f15"
service < u : rift-cli execute layout unjoin; skhd -k "f15"
