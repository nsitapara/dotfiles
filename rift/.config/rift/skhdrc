cmd + shift - 0x56 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 4 --follow
cmd + ctrl + shift - 0x56 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 4
