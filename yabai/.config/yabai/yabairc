#!/bin/bash
set -euo pipefail
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"

# No scripting addition or SIP changes. Based on the docked AeroSpace profile.
yabai -m config layout bsp
yabai -m config split_ratio 0.50
yabai -m config auto_balance off
yabai -m config window_placement second_child
yabai -m config focus_follows_mouse off
yabai -m config mouse_follows_focus on
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config window_gap 15
yabai -m config top_padding 50
yabai -m config bottom_padding 8
yabai -m config left_padding 10
yabai -m config right_padding 10

# Labelled rules replace themselves on reload. App names are yabai's API.
yabai -m rule --add label=dotfiles-utilities \
    app='^(System Settings|System Preferences|Activity Monitor|App Store|Clock|FaceTime|1Password|Nuvio)$' manage=off
yabai -m rule --add label=dotfiles-stack-manager \
    app='^Electron$' title='^Worktree & Stack Manager$' manage=off

# Update app icons for same-app window changes, too.
for event in window_created window_destroyed window_focused window_title_changed; do
    yabai -m signal --add label="dotfiles-$event" event="$event" \
        action='PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"; command -v sketchybar >/dev/null && sketchybar --trigger yabai_windows_changed'
done

# Label available native desktops; missing slots stay dimmed in the bar.
# Missing desktops do not prevent a basic trial. Create them in Mission Control.
"$HOME/.config/yabai/scripts/spaces.sh" || echo 'Run ./wm.sh spaces after creating your six desktops.' >&2
if [ -n "${DOTFILES_YABAI_READY:-}" ]; then
    touch "$DOTFILES_YABAI_READY"
fi
