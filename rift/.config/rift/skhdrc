cmd + shift - 1 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 1 --follow
cmd + ctrl + shift - 1 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 1
cmd - 0x53 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action workspace 1
cmd + shift - 0x53 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 1 --follow
cmd + ctrl + shift - 0x53 : /usr/bin/python3 "$HOME/.config/rift/adapter.py" action send 1
